# Copy to ignored .env and fill locally. Never commit real credentials.
DB_URL=jdbc:postgresql://localhost:5432/rallit
DB_USERNAME=rallit
DB_PASSWORD=
REDIS_DATABASE=0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Generate two independent Base64 encoded random keys of at least 32 bytes.
JWT_SERVICE_KEY=
JWT_ADMIN_KEY=
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8080/api/v1/auth/kakao/callback
# Set callback URLs and allowed origins for your frontend environment.
FRONTEND_CALLBACK_URL=
ADMIN_FRONTEND_CALLBACK_URL=
SERVICE_ORIGINS=
ADMIN_ORIGINS=
# Local HTTP only. Production must use true and HTTPS URLs.
AUTH_SECURE_COOKIES=false
SPRING_PROFILES_ACTIVE=local
# Enable after Google Cloud Web Client configuration.
GOOGLE_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback
