# 실행 환경
SPRING_PROFILES_ACTIVE=
# 로컬 HTTP 테스트에서는 false로 설정합니다. 배포 Compose는 true를 적용합니다.
AUTH_SECURE_COOKIES=true

# PostgreSQL
DB_URL=
DB_USERNAME=rallit
DB_PASSWORD=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=

# JWT 서명 키
JWT_SERVICE_KEY=
JWT_ADMIN_KEY=

# 카카오 로그인
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=

# 구글 로그인
# 구글 로그인에 필요한 세 값을 모두 채웁니다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 구글에 등록한 백엔드 주소에 /api/v1/auth/google/callback을 붙인 값입니다.
GOOGLE_REDIRECT_URI=

# 프론트엔드 콜백과 허용 Origin
# 콜백에는 로그인 완료 페이지의 전체 URL을 입력합니다.
# Origin에는 경로 없이 스킴과 호스트, 필요한 경우 포트를 입력합니다.
FRONTEND_CALLBACK_URL=
ADMIN_FRONTEND_CALLBACK_URL=
SERVICE_ORIGINS=
ADMIN_ORIGINS=

# EC2 배포용 Docker Compose 설정
# deploy.sh가 배포에 성공하면 사용한 이미지로 APP_IMAGE를 기록합니다.
APP_IMAGE=
# EC2에서 DB 컨테이너를 함께 실행하면 local-db로 설정합니다. RDS를 쓰면 비웁니다.
COMPOSE_PROFILES=
POSTGRES_DB=

# 선택 설정은 비워두면 Compose의 기본값을 사용합니다.
APP_PORT=
APP_MEM_LIMIT=
DB_MEM_LIMIT=
# Redis 데이터 상한은 컨테이너 메모리 한도보다 작게 설정합니다.
REDIS_MAXMEMORY=
REDIS_MEM_LIMIT=
