# EC2 배포 디렉터리에 .env로 저장하고 chmod 600을 적용합니다. 실제 값은 커밋하지 않습니다.
# 비밀번호는 openssl rand -hex 32 로 생성한 값을 권장합니다.

# deploy.sh가 배포 성공 시 갱신합니다.
APP_IMAGE=dockerhub-id/rallit-backend:replace-with-git-sha

# 임시 EC2는 temp, RDS 이전 후에는 prod를 사용합니다.
SPRING_PROFILES_ACTIVE=temp

# 임시 EC2는 local-db로 db 컨테이너를 함께 실행합니다. RDS 이전 후에는 값을 비웁니다.
COMPOSE_PROFILES=local-db

# POSTGRES_DB는 DB_URL의 DB 이름과 같아야 합니다. RDS에서는 DB_URL을 RDS 엔드포인트로 바꿉니다.
POSTGRES_DB=rallit
DB_URL=jdbc:postgresql://db:5432/rallit
DB_USERNAME=rallit
DB_PASSWORD=replace-with-strong-password

APP_PORT=8080
APP_MEM_LIMIT=700m
DB_MEM_LIMIT=256m

# Redis는 app과 동일한 Docker 네트워크의 redis:6379에서 실행됩니다.
# 비밀번호는 openssl rand -hex 32로 생성하고 예시값을 교체합니다.
REDIS_PASSWORD=replace-with-strong-redis-password
REDIS_DATABASE=0
# 데이터 상한보다 컨테이너 한도를 크게 두고 EC2의 RAM 여유를 먼저 확인합니다.
REDIS_MAXMEMORY=32mb
REDIS_MEM_LIMIT=128m

# 서로 다른 키 두 개를 각각 openssl rand -base64 32로 생성합니다.
JWT_SERVICE_KEY=replace-with-service-jwt-base64-key
JWT_ADMIN_KEY=replace-with-admin-jwt-base64-key

KAKAO_REST_API_KEY=replace-with-kakao-rest-api-key
# Client Secret 기능을 사용하는 앱이면 입력합니다.
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=replace-with-backend-kakao-callback-url
GOOGLE_LOGIN_ENABLED=false
# Google 활성화 시 아래 세 항목을 모두 입력합니다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# 배포된 FE의 로그인 완료 주소 및 허용 Origin으로 교체합니다.
FRONTEND_CALLBACK_URL=replace-with-service-frontend-callback-url
ADMIN_FRONTEND_CALLBACK_URL=replace-with-admin-frontend-callback-url
SERVICE_ORIGINS=replace-with-service-frontend-origin
ADMIN_ORIGINS=replace-with-admin-frontend-origin
