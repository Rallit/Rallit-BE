# EC2 배포 디렉터리에 .env로 저장하고 chmod 600을 적용합니다. 실제 값은 커밋하지 않습니다.
# 비밀번호는 openssl rand -hex 32 로 생성한 값을 권장합니다.

# deploy.sh가 배포 성공 시 갱신합니다.
APP_IMAGE=dockerhub-id/rallit-backend:replace-with-git-sha

# 임시 EC2는 temp, RDS 이전 후에는 prod를 사용합니다.
SPRING_PROFILES_ACTIVE=temp

# 임시 EC2는 local-db로 db 컨테이너를 함께 실행합니다. RDS 이전 후에는 값을 비웁니다.
COMPOSE_PROFILES=local-db

# POSTGRES_DB는 DB_URL의 DB 이름과 같아야 합니다. RDS에서는 DB_URL을 RDS 엔드포인트로 바꿉니다.
POSTGRES_DB=rallit
DB_URL=jdbc:postgresql://db:5432/rallit
DB_USERNAME=rallit
DB_PASSWORD=replace-with-strong-password

APP_PORT=8080
APP_MEM_LIMIT=700m
DB_MEM_LIMIT=256m
